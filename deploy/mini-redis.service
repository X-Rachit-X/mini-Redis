# systemd unit: runs mini-redis as a background service that starts on boot
# and restarts if it crashes. Installation steps: docs/9-deploy.md
[Unit]
Description=mini-redis in-memory data store
After=network.target
# Give up after 5 failed starts within 2 minutes instead of retrying forever.
# Without this, an AOF holding more data than MemoryMax gets the server killed
# during every replay, in an endless restart loop (tested). The unit then shows
# "failed"; docs/9-deploy.md (Troubleshooting) explains how to recover.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=miniredis
WorkingDirectory=/var/lib/mini-redis
ExecStart=/usr/local/bin/mini-redis-server --bind 127.0.0.1 --port 6379 --aof-file /var/lib/mini-redis/appendonly.aof
# SIGTERM triggers our graceful shutdown (flush + fsync the AOF).
KillSignal=SIGTERM
# mini-redis has no maxmemory setting yet, so let the kernel cap it instead.
# Over this limit the service is killed (and restarted) rather than the VM
# running out of memory. Adjust to your machine.
MemoryMax=256M
Restart=on-failure
RestartSec=2

# Sandboxing: even if a bug were exploited, the process can't gain privileges,
# can't write anywhere except its data folder, and can't see home directories.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/mini-redis
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_UNIX

[Install]
WantedBy=multi-user.target
